# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres connection string. Consumed by prisma/schema.prisma.
# Use Neon's POOLED endpoint (host contains "-pooler") with pgbouncer=true.
# The direct (non-pooler) endpoint drops connections on idle and can fail the
# first query after a Neon compute cold-start with P1001; the pooler does not.
# connection_limit=1 keeps each serverless instance to a single pooled slot.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.REGION.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=1"

# ---------------------------------------------------------------------------
# Auth (NextAuth)
# ---------------------------------------------------------------------------
# Session encryption secret. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# Site URLs
# ---------------------------------------------------------------------------
# Public origin of the deployment. Used for canonical/OG URLs (src/config/brand.js).
# Falls back to a hardcoded production URL if unset, so set it per environment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Absolute origin used in transactional email templates (newsletter welcome mail).
NEXT_BASE_URL_FULL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email (Nodemailer SMTP)
# ---------------------------------------------------------------------------
# For Gmail, EMAIL_PASS must be a 16-character App Password, not the account
# password: https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="you@example.com"
EMAIL_PASS="your-smtp-app-password"
EMAIL_FROM="Your Store <you@example.com>"

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Enables shipping charges. Accepts 1/true/yes/on.
# Both are needed and must agree: the server value authorises the charge at
# order creation, the NEXT_PUBLIC_ one shows it in the checkout UI.
SHIPPING_ENABLED="false"
NEXT_PUBLIC_SHIPPING_ENABLED="false"

# ---------------------------------------------------------------------------
# NODE_ENV is set automatically by Next.js (development / production).
# Setting it here is not required and overriding it can break builds.
# NODE_ENV="development"
